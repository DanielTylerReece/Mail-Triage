# ============================================================
# Microsoft 365 / Entra app registration (Application permissions)
# Required scope: Mail.ReadWrite.
# Mail.Send is NOT used — the service is read+move only.
# See docs/SETUP.md for the full setup, including the required
# Application Access Policy that scopes the app to specific mailboxes.
# ============================================================
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me

# ============================================================
# Webhook
# WEBHOOK_URL must be a public HTTPS URL that reaches this container's port.
# WEBHOOK_CLIENT_STATE: a long random string. Generate: openssl rand -hex 32
# ============================================================
WEBHOOK_URL=https://mailtriage.example.com/graph-webhook
WEBHOOK_CLIENT_STATE=replace-with-a-long-random-string

# ============================================================
# LLM provider for Tier 2 classification
#
# LLM_PROVIDER:  anthropic | openai
# LLM_MODEL:     model name for the chosen provider
#
# Recommended models (cheap and fast for classification):
#   anthropic: claude-haiku-4-5-20251001
#   openai:    gpt-4o-mini
#
# Only the API key for the chosen provider is required.
# ============================================================
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=60

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ============================================================
# Scaling
#
# CONCURRENCY: number of parallel Tier-2 workers. Default 1.
#              Increase if you have many mailboxes or high volume.
# ============================================================
CONCURRENCY=1

# ============================================================
# DRY-RUN MODE — recommended for first-time setup.
#
# When DRY_RUN=true, the service classifies every incoming message and
# records what it WOULD have done in the audit DB, but does NOT actually
# move anything. Use this for the first week of operation to validate
# rules + the LLM classifier against real mail. Then set to false to
# enable live action.
#
# Behavior in dry-run:
#   - Webhook receives notifications normally
#   - Tier 1 rules and Tier 2 LLM both run
#   - Cross-mailbox guard runs (so violations show even in dry-run)
#   - graph.move_message is NOT called
#   - Audit rows record action='dry-run' for easy filtering
#   - `mailtriage status` highlights dry-run counts
#   - /healthz returns "dry_run": true
#
# Recommended first-time sequence:
#   1. DRY_RUN=true   → run for ~1 week, run `mailtriage status` daily,
#                       tune config/rules.txt based on what shows up.
#   2. DRY_RUN=false  → enable live action.
# ============================================================
DRY_RUN=true

# Audit DB retention. Daily purge runs at 03:00 UTC and removes rows
# older than this. Set to 0 to disable purging (audit grows forever).
AUDIT_RETENTION_DAYS=90

# Webhook receiver port (inside container)
PORT=8088

# ============================================================
# Exchange Online operations via ./scripts/exo.sh (Linux-only,
# pwsh-in-Docker — no Windows host required).
#
# These are only consumed by exo.sh; the mailtriage container itself
# does not read them. Set them once and re-use across setup / sync /
# verify operations.
# ============================================================
EXO_GROUP_ADDRESS=mailtriage-scope@your-tenant.onmicrosoft.com
EXO_APP_ID=00000000-0000-0000-0000-000000000000
EXO_CONTROL_MAILBOX=someone-else@your-tenant.onmicrosoft.com
